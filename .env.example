# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# On Alwaysdata, set the same variables as site environment variables
# (Web > Sites > your site > Environment variables) instead.

# Set to False in production
DEBUG=True

# Generate a real secret: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="-7anvt_k@!ik)v*0=(l)_hpik@fsf+x0&%3em051im0b2-2z63"

# Comma-separated hosts, e.g. mybook.alwaysdata.net
ALLOWED_HOSTS=

# MySQL credentials (your Alwaysdata MySQL database)
DB_NAME=django_mybook
DB_HOST=mysql-django.alwaysdata.net
DB_USER=django
DB_PASSWORD=modcom2026

# Comma-separated browser origins allowed to call the API, e.g.
# CORS_ALLOWED_ORIGINS=https://mybook-frontend.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated trusted origins for CSRF (admin/session auth), e.g.
# CSRF_TRUSTED_ORIGINS=https://mybook.alwaysdata.net
CSRF_TRUSTED_ORIGINS=
